#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct FireballUniforms
{
    float4 time; // x = elapsed seconds
};

struct main0_out
{
    float4 color [[color(0)]];
};

struct main0_in
{
    float4 vertexColor [[user(locn0)]];
    float2 texCoord [[user(locn1)]];
};

// --- Noise ---

float hash2(float2 p)
{
    p = fract(p * float2(0.1031, 0.1030));
    p += dot(p, p.yx + 33.33);
    return fract((p.x + p.y) * p.x);
}

float valueNoise(float2 p)
{
    float2 i = floor(p);
    float2 f = fract(p);
    float2 u = f * f * (3.0 - 2.0 * f);

    return mix(
        mix(hash2(i + float2(0, 0)), hash2(i + float2(1, 0)), u.x),
        mix(hash2(i + float2(0, 1)), hash2(i + float2(1, 1)), u.x),
        u.y);
}

float fbm(float2 p)
{
    float value = 0.0;
    float amplitude = 0.5;
    float2x2 rot = float2x2(
        float2( 0.80,  0.60),
        float2(-0.60,  0.80)
    );

    for (int i = 0; i < 5; i++)
    {
        value += amplitude * valueNoise(p);
        p = rot * p * 2.0 + float2(100.0);
        amplitude *= 0.5;
    }
    return value;
}

// --- Main ---

fragment main0_out main0(main0_in in [[stage_in]],
                         constant FireballUniforms& uniforms [[buffer(0)]])
{
    main0_out out = {};

    float time = uniforms.time.x;
    float2 uv = in.texCoord;

    // Center UV to [-1, 1]
    float2 centered = uv * 2.0 - 1.0;
    float dist = length(centered);

    // Circular falloff — discard outside the circle
    if (dist > 1.0) {
        discard_fragment();
    }

    // Polar coordinates for swirl
    float angle = atan2(centered.y, centered.x);

    // Swirl: rotate angle based on distance and time
    float swirl = angle + dist * 3.0 - time * 2.5;

    // Noise lookup in swirled polar space
    float2 noiseCoord = float2(swirl * 0.5, dist * 2.0);
    float n1 = fbm(noiseCoord + float2(time * 0.3, -time * 0.2));
    float n2 = fbm(noiseCoord * 1.5 + float2(-time * 0.4, time * 0.15) + float2(5.2, 1.3));

    // Combine noise for turbulent structure
    float turbulence = n1 * 0.6 + n2 * 0.4;

    // Radial intensity: bright core, fading edge
    float core = 1.0 - smoothstep(0.0, 0.5, dist);
    float glow = 1.0 - smoothstep(0.2, 1.0, dist);

    // Fire intensity combines radial falloff with noise
    float intensity = glow * (0.4 + turbulence * 0.8) + core * 0.6;

    // Base color from vertex color, boosted by intensity
    float3 baseColor = in.vertexColor.rgb;

    // Add bright white-hot core
    float3 hotCore = float3(1.0, 1.0, 0.9) * core * 0.5;

    // Final color: tinted by base with hot core
    float3 color = baseColor * intensity + hotCore;

    // Soft edge alpha
    float alpha = smoothstep(1.0, 0.7, dist) * (0.6 + turbulence * 0.4);

    out.color = float4(max(color, 0.0), alpha);
    return out;
}
